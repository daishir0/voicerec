{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // ⚠️ baseUrl は TypeScript 6 で非推奨。paths を tsconfig からの相対で書けば要らない
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
